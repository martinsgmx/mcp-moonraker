# mcp-moonraker environment variables
#
# This file is documentation, not automatically loaded. Export these variables
# in your shell, process manager, container, or MCP client configuration.
#
# Never commit a filled-in copy. Values below are intentionally empty.

# ---------------------------------------------------------------------------
# Moonraker connection
# ---------------------------------------------------------------------------

# Base URL of Moonraker. May include a reverse-proxy path prefix.
# Default: http://127.0.0.1:7125
MOONRAKER_URL=

# Moonraker API key, sent as X-Api-Key. Only needed if Moonraker requires it.
# Prefer a secret manager over a shell history.
MOONRAKER_API_KEY=

# Request timeout in seconds (1-300). Default: 15
# MOONRAKER_TIMEOUT_SECS=15

# Verify TLS certificates. Do not disable for internet-facing hosts.
# Default: true
# MOONRAKER_TLS_VERIFY=true

# Maximum JSON response size from Moonraker (1 KiB-64 MiB).
# Default: 8388608
# MOONRAKER_MAX_RESPONSE_BYTES=8388608

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

# stdio (default) or http.
# MCP_MOONRAKER_TRANSPORT=stdio

# HTTP bind address and port. Defaults: 127.0.0.1 and 8765.
# MCP_MOONRAKER_HTTP_HOST=127.0.0.1
# MCP_MOONRAKER_HTTP_PORT=8765

# Streamable HTTP endpoint path. Default: /mcp
# MCP_MOONRAKER_HTTP_PATH=/mcp

# Static bearer token. Required when binding HTTP to a non-loopback address.
# Generate with: openssl rand -hex 32
MCP_MOONRAKER_HTTP_TOKEN=

# Comma-separated extra Host values for DNS-rebinding protection.
# MCP_MOONRAKER_HTTP_ALLOWED_HOSTS=mcp.example.com

# Comma-separated extra browser origins for CORS.
# MCP_MOONRAKER_HTTP_ALLOWED_ORIGINS=https://app.example.com

# Explicitly allow unauthenticated non-loopback HTTP. Never use on an
# untrusted network.
# MCP_MOONRAKER_HTTP_ALLOW_UNAUTHENTICATED=false

# ---------------------------------------------------------------------------
# Safety policy
# ---------------------------------------------------------------------------

# Deny every mutation. Emergency stop remains available.
# MCP_MOONRAKER_READ_ONLY=false

# Master switch for reversible mutations.
# MCP_MOONRAKER_ALLOW_MUTATIONS=true

# Arbitrary G-code. Strongly discouraged, still approval-gated when enabled.
# MCP_MOONRAKER_ALLOW_RAW_GCODE=false

# Reboot, shutdown, service restart, and updates.
# MCP_MOONRAKER_ALLOW_HOST_ADMIN=false

# Reserved; no configuration write tools ship in v0.1.
# MCP_MOONRAKER_ALLOW_CONFIG_WRITE=false

# Hard heater limits in degrees Celsius.
# MCP_MOONRAKER_MAX_HOTEND_TEMP=300
# MCP_MOONRAKER_MAX_BED_TEMP=120

# Removes the only always-allowed action. Do not set unless you know why.
# MCP_MOONRAKER_DISABLE_EMERGENCY_STOP=false

# ---------------------------------------------------------------------------
# Approvals
# ---------------------------------------------------------------------------

# in_band, out_of_band, or both. Use out_of_band/both for autonomous agents.
# MCP_MOONRAKER_APPROVAL_MODE=in_band

# How long a prepared action remains valid (5-3600 seconds). Default: 120
# MCP_MOONRAKER_APPROVAL_TTL_SECS=120

# Where approval records are stored. Must match for the server and the CLI.
# Default: $XDG_STATE_HOME/mcp-moonraker or ~/.local/state/mcp-moonraker
# MCP_MOONRAKER_STATE_DIR=/var/lib/mcp-moonraker

# ---------------------------------------------------------------------------
# Camera
# ---------------------------------------------------------------------------

# Maximum snapshot size (1 KiB-64 MiB). Default: 8388608
# MCP_MOONRAKER_CAMERA_MAX_BYTES=8388608

# Snapshot timeout in seconds (1-120). Default: 10
# MCP_MOONRAKER_CAMERA_TIMEOUT_SECS=10

# Allow webcams on private/LAN addresses. Most printers need this.
# MCP_MOONRAKER_CAMERA_ALLOW_PRIVATE_HOSTS=true

# Optional comma-separated camera host allow-list. Empty means any host from
# Moonraker's webcam list. Metadata endpoints are always blocked.
# MCP_MOONRAKER_CAMERA_ALLOWED_HOSTS=192.168.1.50,cam.local

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# tracing filter. Logs always go to stderr.
# MCP_MOONRAKER_LOG_LEVEL=info

# Persistent JSON-lines audit log. Unset means stderr.
# MCP_MOONRAKER_AUDIT_LOG=/var/log/mcp-moonraker/audit.jsonl

# Config file path, equivalent to --config.
# MCP_MOONRAKER_CONFIG=/etc/mcp-moonraker.toml
